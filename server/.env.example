# Backend SCTEC (#144 Fase 2) — copie para .env e ajuste. NUNCA commite o .env real.
PORT=3000
# Conexão PostgreSQL (Podman) — ver compose.yaml
DATABASE_URL=postgres://sctec:troque-esta-senha@localhost:5432/sctec
# Segredo do JWT (troque por um valor forte e aleatório)
JWT_SECRET=troque-por-um-segredo-forte
JWT_EXPIRES=15m
# Origens permitidas no CORS (front do SCTEC), separadas por vírgula
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
